#!/usr/bin/env bash
set -e
if [[ ! -d "/home/asatya/Dev/personal/dycodev.com/kelas-setara" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/home/asatya/Dev/personal/dycodev.com/kelas-setara")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/home/asatya/Dev/personal/dycodev.com/kelas-setara" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/home/asatya/Dev/personal/dycodev.com/kelas-setara/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/home/asatya/Dev/personal/dycodev.com/kelas-setara/.envrc" "/home/asatya/Dev/personal/dycodev.com/kelas-setara/.direnv"/*.rc
